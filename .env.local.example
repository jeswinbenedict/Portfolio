# ─────────────────────────────────────────────────────────────
# Stealth Analytics — Environment Variables
# Copy this file to .env.local and fill in the values
# ─────────────────────────────────────────────────────────────

# ── Upstash Redis (Storage) ──────────────────────────────────
# Get these from: https://console.upstash.com
# Or via Vercel Integration → Upstash (auto-sets these)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Resend (Email) ───────────────────────────────────────────
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=
# Optional: custom from email (requires domain verification)
# Default: onboarding@resend.dev
RESEND_FROM_EMAIL=

# ── Vercel Cron Secret ───────────────────────────────────────
# Set this to a random string to protect the digest endpoint
# Vercel auto-sets this when you deploy with cron
CRON_SECRET=
