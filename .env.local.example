# ─────────────────────────────────────────────────────────────
# Stealth Analytics — Environment Variables
# Copy this file to .env.local and fill in the values
# ─────────────────────────────────────────────────────────────

# ── Upstash Redis (Storage) ──────────────────────────────────
# Get these from: https://console.upstash.com
# Or via Vercel Integration → Upstash (auto-sets these)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Resend (Email) ───────────────────────────────────────────
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=
# Optional: custom from email (requires domain verification)
# Default: onboarding@resend.dev
RESEND_FROM_EMAIL=

# ── Vercel Cron Secret ───────────────────────────────────────
# Set this to a random string to protect the digest endpoint
# Vercel auto-sets this when you deploy with cron
CRON_SECRET=

# ── Auth: session signing ────────────────────────────────────
# Signs the session JWT stored in the httpOnly cookie.
# Generate one with:  openssl rand -base64 32
# Changing it instantly invalidates every existing session.
SESSION_SECRET=

# ── Auth: GitHub OAuth ───────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
# See devops/docs/09-oauth.md for the full walkthrough.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Base URL used to build the OAuth redirect_uri. Must match the callback URL
# registered on GitHub EXACTLY (scheme, host, port — no trailing slash).
#   local   http://localhost:3000
#   EC2     http://<public-ip>:3000
#   domain  https://yourdomain.com
APP_BASE_URL=http://localhost:3000
